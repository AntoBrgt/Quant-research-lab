# Every environment variable read by src/config.py and the data modules. All are optional.
# Copy to .env, then UNCOMMENT only the lines you set: an empty value is not the same as
# unset (e.g. an empty LLM_ENABLED turns the LLM layer off). Defaults in brackets. Never commit .env.

# --- Data sources ---
# OPENFIGI_API_KEY=            # free at openfigi.com; CUSIP lookups go from 25/min to much faster [unset]
# DEFAULT_BENCHMARK_TICKER=    # [SPY]

# --- LLM layer (live research only; never used by any backtest) ---
# LLM_PROVIDER=                # ollama | anthropic | openai [ollama]
# LLM_ENABLED=                 # true | false [true]
# OLLAMA_BASE_URL=             # [http://localhost:11434]
# OLLAMA_MODEL=                # [llama3.2]
# ANTHROPIC_API_KEY=           # required when LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=             # [claude-haiku-4-5]
# OPENAI_API_KEY=              # required when LLM_PROVIDER=openai
# OPENAI_MODEL=                # [gpt-4o-mini]
# LLM_REQUEST_TIMEOUT_SECONDS= # [120]

# --- Cache and cost guards ---
# CACHE_ENABLED=               # [true]
# MAX_LLM_INPUT_CHARS=         # [8000]
# MAX_LLM_CALLS_PER_RUN=       # [500]
# MAX_SIGNALS_PER_CHUNK=       # [15]
# MAX_MENTIONS_PER_CHUNK=      # [15]
